# Copy this file to .env and fill in your keys.
# .env is git-ignored — NEVER commit actual keys.

GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Optional — Reddit OAuth (free "script" app: https://www.reddit.com/prefs/apps)
# Reddit returns HTTP 403 to unauthenticated API requests. Without these the
# Reddit collector is skipped and the gap is documented as a limitation.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
